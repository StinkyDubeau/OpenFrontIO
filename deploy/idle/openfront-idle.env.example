# systemd reads IDLE_IMAGE; Docker passes the remaining values to the app.
# Replace this placeholder with the immutable digest emitted by idle-ci.yml.
IDLE_IMAGE_REPOSITORY=ghcr.io/owner/repository
IDLE_IMAGE=ghcr.io/owner/repository@sha256:replace_with_64_hex_characters

GAME_ENV=prod
NUM_WORKERS=1
DOMAIN=idle.example.com
CDN_BASE=
TURNSTILE_SITE_KEY=replace_before_player_auth_is_enabled
API_KEY=
ADMIN_BOT_API_KEY=

IDLE_DB_PATH=/var/lib/openfront-idle/idle.sqlite
IDLE_ADMIN_ENABLED=false
IDLE_ADMIN_TOKEN=
IDLE_TELEMETRY_HMAC_SECRET=replace_with_at_least_32_random_characters
IDLE_RAW_TAP_RETENTION_DAYS=14
# Must match the isolated Docker network gateway created in the runbook.
IDLE_TRUSTED_PROXY_ADDRESS=172.30.0.1
